{
  "name": "fichas",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.sw.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.node.json",
    "preview": "vite preview",
    "cf": "node --env-file=.env ./node_modules/wrangler/bin/wrangler.js",
    "deploy": "npm run build && npm run cf -- deploy",
    "types": "wrangler types src/worker/worker-configuration.d.ts --strict-vars=false",
    "db:migrate:local": "wrangler d1 migrations apply fichas-db --local",
    "db:migrate:remote": "npm run cf -- d1 migrations apply fichas-db --remote",
    "seed:local": "tsx scripts/seed-plan.ts --local",
    "seed:remote": "node --env-file=.env ./node_modules/tsx/dist/cli.mjs scripts/seed-plan.ts --remote",
    "test": "vitest run --project unit",
    "test:worker": "vitest run --project worker",
    "e2e": "playwright test",
    "e2e:budgets": "BUDGET_RUNS=20 playwright test",
    "verify:production": "node --import tsx scripts/verify-production.ts",
    "lint": "biome check . && npm run typecheck",
    "format": "biome check --write .",
    "copy:lint": "tsx scripts/copy-lint.ts",
    "eval:parse": "node --env-file=.env ./node_modules/tsx/dist/cli.mjs scripts/eval-parse.ts",
    "eval:plan": "node --env-file=.env ./node_modules/tsx/dist/cli.mjs scripts/eval-plan.ts",
    "eval:kitchen": "node --env-file=.env ./node_modules/tsx/dist/cli.mjs scripts/eval-kitchen.ts",
    "lhci": "lhci autorun",
    "check:secrets": "tsx scripts/check-secrets.ts",
    "gen:vapid": "tsx scripts/gen-vapid.ts",
    "backup:restore": "node --import tsx scripts/restore-backup.ts",
    "backup:verify": "node --import tsx scripts/verify-backup.ts",
    "gen:icons": "tsx scripts/gen-icons.ts",
    "size": "tsx scripts/check-size.ts"
  },
  "dependencies": {
    "@preact/signals": "2.11.3",
    "dexie": "4.4.6",
    "hono": "4.13.13",
    "lucide-preact": "1.53.0",
    "preact": "11.0.1",
    "web-push-neo": "0.1.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@cloudflare/vite-plugin": "1.63.1",
    "@cloudflare/vitest-plugin": "1.4.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "puppeteer-core": "25.13.0",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "wrangler": "4.149.0"
  }
}
