{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fichas",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-09",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/n/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fichas-db",
      "database_id": "86f54c6f-5480-4f67-9ca4-9eef76247dca",
      "migrations_dir": "migrations"
    }
  ],
  // Plan files and weekly backups. R2 instead of KV: see docs/DECISIONS.md.
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "fichas-files" }],
  "durable_objects": { "bindings": [{ "name": "PLAN_JOBS", "class_name": "PlanReadJob" }] },
  "migrations": [{ "tag": "plan-jobs-v1", "new_sqlite_classes": ["PlanReadJob"] }],
  "triggers": { "crons": ["*/15 * * * *"] },
  "observability": { "enabled": true },
  "vars": {
    "APP_VERSION": "2.0.0",
    "TZ_DEFAULT": "America/Mexico_City",
    "BACKUPS_ENABLED": "true",
    "OPENROUTER_BASE_URL": "https://openrouter.ai/api/v1",
    "MODEL_FAST": "openai/gpt-6-luna",
    "MODEL_PLAN_A": "anthropic/claude-sonnet-5.5",
    "MODEL_PLAN_B": "google/gemini-3.1-pro-preview",
    "MODEL_VISION": "openai/gpt-6-luna",
    // JEV (TypeSafe System One) for live food categorization; the key is the JEV_API_KEY secret.
    "JEV_BASE_URL": "https://api.typesafe.ai",
    "JEV_MODEL": "jev-latest",
    "VAPID_PUBLIC_KEY": "BGnKoS4ylU-DVZeWrcJDwQhKSujFZBq14FLN4hdu9qVXlvQ3-OzGy8WlAWwBilsl-_JVseFp3tskxQCOeLO8jpg",
    "VAPID_SUBJECT": "https://fichas.toolco.workers.dev"
  }
}
